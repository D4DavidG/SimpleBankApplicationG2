# named but unread. Whichever answer lands, the connection string belongs here
# and never in a committed file.
#
# DATABASE_URL=mysql://bank_app:CHANGE_ME@localhost:3306/simple_bank
# MONGODB_URI=mongodb://localhost:27017/simple_bank

# script.pdf happens to contain no bytes that make Git guess "binary", so
# core.autocrlf would rewrite its line endings on checkout and hand the next
# person a PDF their reader refuses to open. Say so explicitly.
*.pdf binary

# These are read by Linux, not by us. A CRLF in the shebang makes the kernel
# look for an interpreter called "/bin/bash\r", and the error it prints -
# "bad interpreter: No such file or directory" - names a file that plainly
# exists. systemd is equally unamused by a unit file with carriage returns.
*.sh text eol=lf
*.service text eol=lf
